<?xml version="1.0" ?>
<robot name="xbot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>false</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="lb_wheel_1">
  <material>${body_color}</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="lf_wheel_1">
  <material>${body_color}</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="rb_wheel_1">
  <material>${body_color}</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="rf_wheel_1">
  <material>${body_color}</material>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo>
  <plugin
    filename="ignition-gazebo-diff-drive-system"
    name="ignition::gazebo::systems::DiffDrive">

    <!-- Left wheels -->
    <left_joint>left_front_wheel_joint</left_joint>
    <left_joint>left_rear_wheel_joint</left_joint>

    <!-- Right wheels -->
    <right_joint>right_front_wheel_joint</right_joint>
    <right_joint>right_rear_wheel_joint</right_joint>

    <!-- Dimensions measured from the exported model -->
    <wheel_separation>0.12</wheel_separation>
    <wheel_radius>0.025</wheel_radius>

    <!-- Gazebo Transport topics -->
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <tf_topic>tf</tf_topic>

    <!-- Odometry frames -->
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publish_frequency>30</odom_publish_frequency>

    <!-- Conservative initial limits -->
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <max_angular_acceleration>2.0</max_angular_acceleration>
  </plugin>
</gazebo>
</robot>
