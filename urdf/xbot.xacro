<?xml version="1.0" ?>
<robot name="xbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find xbot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find xbot_description)/urdf/xbot.ros2control" />
<xacro:include filename="$(find xbot_description)/urdf/xbot.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.005" rpy="0 0 0"/>
    <mass value="0.9450826877913348"/>
    <inertia ixx="0.000801" iyy="0.001146" izz="0.001931" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find xbot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz="0 0 0.005" rpy="0 0 0"/>
  <geometry>
    <box size="0.12 0.11 0.01"/>
  </geometry>
</collision>
</link>

<link name="lb_wheel_1">
  <inertial>
    <origin xyz="-4.1874584825324357e-07 -0.0049999999999999975 -6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.1541343895667492"/>
    <inertia ixx="2.5e-05" iyy="4.8e-05" izz="2.5e-05" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.049055 0.055 -0.005" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find xbot_description)/meshes/lb_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz="0 -0.005 0" rpy="1.5708 0 0"/>
  <geometry>
    <cylinder radius="0.025" length="0.01"/>
  </geometry>
</collision>
</link>

<link name="lf_wheel_1">
  <inertial>
    <origin xyz="4.1874584825324357e-07 -0.0049999999999999975 -6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.1541343895667492"/>
    <inertia ixx="2.5e-05" iyy="4.8e-05" izz="2.5e-05" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.049055 0.055 -0.005" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find xbot_description)/meshes/lf_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz="0 -0.005 0" rpy="1.5708 0 0"/>
  <geometry>
    <cylinder radius="0.025" length="0.01"/>
  </geometry>
</collision>
</link>

<link name="rb_wheel_1">
  <inertial>
    <origin xyz="-4.1874584825324357e-07 0.0049999999999999975 -6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.1541343895667492"/>
    <inertia ixx="2.5e-05" iyy="4.8e-05" izz="2.5e-05" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.049055 -0.055 -0.005" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find xbot_description)/meshes/rb_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz="0 0.005 0" rpy="1.5708 0 0"/>
  <geometry>
    <cylinder radius="0.025" length="0.01"/>
  </geometry>
</collision>
</link>

<link name="rf_wheel_1">
  <inertial>
    <origin xyz="4.1874584825324357e-07 0.0049999999999999975 -6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.1541343895667492"/>
    <inertia ixx="2.5e-05" iyy="4.8e-05" izz="2.5e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.049055 -0.055 -0.005" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find xbot_description)/meshes/rf_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
  <origin xyz="0 0.005 0" rpy="1.5708 0 0"/>
  <geometry>
    <cylinder radius="0.025" length="0.01"/>
  </geometry>
</collision>
</link>

<joint name="left_front_wheel_joint" type="continuous">
  <origin xyz="-0.049055 -0.055 0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lf_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="left_rear_wheel_joint" type="continuous">
  <origin xyz="0.049055 -0.055 0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lb_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="right_front_wheel_joint" type="continuous">
  <origin xyz="-0.049055 0.055 0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rf_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="right_rear_wheel_joint" type="continuous">
  <origin xyz="0.049055 0.055 0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rb_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>



</robot>
